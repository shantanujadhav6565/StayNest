<% layout('layouts/boilerplate') -%>

<style>
    /* =====================================================
       CATEGORY FILTERS
    ===================================================== */

    .filters {
        display: flex;
        gap: 28px;
        padding: 20px 5px 15px;
        margin-bottom: 5px;

        overflow-x: auto;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
    }

    .filters::-webkit-scrollbar {
        display: none;
    }

    .filter {
        min-width: 75px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        text-decoration: none;
        color: #555;

        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .filter > div {
        width: 45px;
        height: 45px;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 22px;

        border-radius: 50%;
        background: #f5f5f5;

        transition: all 0.2s ease;
    }

    .filter p {
        margin: 8px 0 0;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .filter:hover {
        color: #000;
        transform: translateY(-3px);
    }

    .filter:hover > div {
        background: #222;
        color: white;
    }


    /* =====================================================
       TAX TOGGLE
    ===================================================== */

    #tax-toggle {
        display: flex;
        justify-content: flex-end;
        align-items: center;

        margin: 10px 0 25px;
    }

    #tax-toggle .form-check {
        border: 1px solid #ddd;
        border-radius: 30px;

        padding: 9px 15px 9px 42px;

        background: #fff;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
    }

    #tax-toggle .form-check-label {
        font-size: 13px;
        font-weight: 600;
        color: #444;
        cursor: pointer;
    }

    #tax-toggle .form-check-input {
        cursor: pointer;
    }

    #tax-toggle .form-check-input:checked {
        background-color: #222;
        border-color: #222;
    }


    /* =====================================================
       SEARCH / CATEGORY MESSAGE
    ===================================================== */

    .search-message {
        border-radius: 12px;
        font-size: 15px;
        padding: 13px 15px;
    }


    /* =====================================================
       LISTING CARD
    ===================================================== */

    .listing-link {
        text-decoration: none;
        color: inherit;

        display: inline-block;

        width: 100%;
        max-width: 300px;

        margin-bottom: 35px;

        vertical-align: top;
    }

    .listing-card {
        width: 100%;
        border: none;
        background: transparent;

        transition: all 0.25s ease;
    }

    .listing-card:hover {
        transform: translateY(-5px);
    }


    /* =====================================================
       IMAGE
    ===================================================== */

    .listing-card .card-img-top {
        width: 100%;
        height: 270px;

        object-fit: cover;

        border-radius: 18px;

        display: block;

        transition: all 0.3s ease;
    }

    .listing-card:hover .card-img-top {
        filter: brightness(0.96);
    }


    /* =====================================================
       CARD BODY
    ===================================================== */

    .listing-card .card-body {
        padding: 12px 3px 0;
    }

    .listing-card .card-text {
        margin: 0;

        font-size: 14px;
        line-height: 1.6;

        color: #555;
    }

    .listing-card .card-text b {
        color: #222;
        font-size: 15px;

        display: inline-block;

        max-width: 100%;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .listing-price {
        color: #222;
        font-weight: 700;
        font-size: 14px;
    }

    .tax-info {
        display: none;

        color: #777;
        font-size: 12px;
        font-style: normal;
    }

    .tax-info.show {
        display: inline;
    }


    /* =====================================================
       EMPTY LIST
    ===================================================== */

    .empty-message {
        margin: 40px auto;
        max-width: 500px;

        border-radius: 14px;
        padding: 15px;
    }


    /* =====================================================
       TABLET
    ===================================================== */

    @media (max-width: 992px) {

        .filters {
            gap: 22px;
        }

        .listing-link {
            max-width: 31%;
            margin-right: 1%;
        }

        .listing-card .card-img-top {
            height: 230px;
        }
    }


    /* =====================================================
       MOBILE
    ===================================================== */

    @media (max-width: 768px) {

        .filters {
            gap: 20px;

            padding: 15px 3px 12px;

            margin-left: -5px;
            margin-right: -5px;
        }

        .filter {
            min-width: 65px;
        }

        .filter > div {
            width: 42px;
            height: 42px;
            font-size: 19px;
        }

        .filter p {
            font-size: 11px;
        }


        /* TAX TOGGLE */

        #tax-toggle {
            justify-content: center;
            margin: 10px 0 20px;
        }

        #tax-toggle .form-check {
            width: 100%;
            max-width: 330px;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 10px 15px;
        }


        /* LISTING */

        .listing-link {
            display: block;

            width: 100%;
            max-width: 100%;

            margin-bottom: 28px;
        }

        .listing-card {
            width: 100%;
        }

        .listing-card .card-img-top {
            height: 250px;
            border-radius: 15px;
        }

        .listing-card .card-body {
            padding: 10px 2px 0;
        }

        .listing-card .card-text {
            font-size: 13px;
        }

        .listing-card .card-text b {
            font-size: 15px;
        }
    }


    /* =====================================================
       SMALL MOBILE
    ===================================================== */

    @media (max-width: 480px) {

        .filters {
            gap: 17px;
        }

        .filter {
            min-width: 62px;
        }

        .filter > div {
            width: 40px;
            height: 40px;
            font-size: 18px;
        }

        .filter p {
            font-size: 10px;
        }


        .listing-card .card-img-top {
            height: 230px;
            border-radius: 14px;
        }

        .listing-card .card-body {
            padding-top: 8px;
        }

        .listing-card .card-text b {
            font-size: 14px;
        }

        .listing-price {
            font-size: 13px;
        }

        .search-message {
            font-size: 13px;
            margin-top: 15px !important;
        }
    }


    /* =====================================================
       VERY SMALL PHONES
    ===================================================== */

    @media (max-width: 360px) {

        .filters {
            gap: 14px;
        }

        .filter {
            min-width: 58px;
        }

        .filter > div {
            width: 38px;
            height: 38px;
        }

        .listing-card .card-img-top {
            height: 210px;
        }
    }
</style>

