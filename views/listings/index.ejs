<% layout('layouts/boilerplate') -%>


<!-- ================================================= -->
<!-- FILTERS -->
<!-- ================================================= -->

<div class="filters-container">

    <div class="filters">

        <!-- TRENDING -->
        <a
            href="/listings?category=Trending"
            class="filter"
        >
            <div>
                <i class="fa-solid fa-fire"></i>
            </div>
            <p>Trending</p>
        </a>


        <!-- ROOMS -->
        <a
            href="/listings?category=Rooms"
            class="filter"
        >
            <div>
                <i class="fa-solid fa-bed"></i>
            </div>
            <p>Rooms</p>
        </a>


        <!-- ICONIC CITIES -->
        <a
            href="/listings?category=Iconic%20Cities"
            class="filter"
        >
            <div>
                <i class="fa-solid fa-mountain-city"></i>
            </div>
            <p>Iconic Cities</p>
        </a>


        <!-- MOUNTAINS -->
        <a
            href="/listings?category=Mountains"
            class="filter"
        >
            <div>
                <i class="fa-solid fa-mountain"></i>
            </div>
            <p>Mountains</p>
        </a>


        <!-- CASTLES -->
        <a
            href="/listings?category=Castles"
            class="filter"
        >
            <div>
                <i class="fa-brands fa-fort-awesome"></i>
            </div>
            <p>Castles</p>
        </a>


        <!-- AMAZING POOL -->
        <a
            href="/listings?category=Amazing%20Pool"
            class="filter"
        >
            <div>
                <i class="fa-solid fa-person-swimming"></i>
            </div>
            <p>Amazing Pool</p>
        </a>


        <!-- CAMPING -->
        <a
            href="/listings?category=Camping"
            class="filter"
        >
            <div>
                <i class="fa-solid fa-tents"></i>
            </div>
            <p>Camping</p>
        </a>


        <!-- FARMS -->
        <a
            href="/listings?category=Farms"
            class="filter"
        >
            <div>
                <i class="fa-solid fa-cow"></i>
            </div>
            <p>Farms</p>
        </a>


        <!-- ARCTIC -->
        <a
            href="/listings?category=Arctic"
            class="filter"
        >
            <div>
                <i class="fa-regular fa-snowflake"></i>
            </div>
            <p>Arctic</p>
        </a>

    </div>


    <!-- ================================================= -->
    <!-- TAX SWITCH -->
    <!-- ================================================= -->

    <div id="tax-toggle">

        <div class="form-check form-switch">

            <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="switchCheckDefault"
            >

            <label
                class="form-check-label"
                for="switchCheckDefault"
            >
                Display after taxes
            </label>

        </div>

    </div>

</div>



<!-- ================================================= -->
<!-- SEARCH MESSAGE -->
<!-- ================================================= -->

<% if (
    typeof searchMessage !== "undefined" &&
    searchMessage
) { %>

    <div
        class="alert alert-warning text-center mt-4 search-message"
        role="alert"
    >

        <i class="fa-solid fa-location-dot"></i>

        <%= searchMessage %>

    </div>

<% } %>



<!-- ================================================= -->
<!-- CATEGORY MESSAGE -->
<!-- ================================================= -->

<% if (
    typeof categoryMessage !== "undefined" &&
    categoryMessage
) { %>

    <div
        class="alert alert-info text-center mt-4 search-message"
        role="alert"
    >

        <i class="fa-solid fa-circle-info"></i>

        <%= categoryMessage %>

    </div>

<% } %>



<!-- ================================================= -->
<!-- LISTINGS -->
<!-- ================================================= -->

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-4">

    <% for(let listing of allListings){ %>


        <a
            href="/listings/<%= listing._id %>"
            class="listing-link"
        >


            <div class="card col listing-card">


                <!-- ================= IMAGE ================= -->

                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top"
                    alt="listing_image"
                >


                <!-- ================= IMAGE OVERLAY ================= -->

                <div class="card-img-overlay">

                    <h5 class="card-title"></h5>

                    <p class="card-text"></p>

                    <p class="card-text">
                        <small></small>
                    </p>

                </div>


                <!-- ================= CARD BODY ================= -->

                <div class="card-body">

                    <p class="card-text">


                        <!-- TITLE -->

                        <b>
                            <%= listing.title %>
                        </b>


                        <br>


                        <!-- ================= PRICE ================= -->

                        <span
                            class="listing-price"
                            data-price="<%= listing.price %>"
                        >

                            &#8377;<%= Number(
                                listing.price
                            ).toLocaleString("en-IN") %>

                        </span>


                        / night


                        <!-- ================= TAX INFO ================= -->

                        <i class="tax-info">
                            &nbsp;+18% GST
                        </i>


                    </p>

                </div>


            </div>


        </a>


    <% } %>

</div>



<!-- ================================================= -->
<!-- NO LISTINGS -->
<!-- ================================================= -->

<% if (
    allListings.length === 0 &&
    !searchMessage &&
    !categoryMessage
) { %>

    <div
        class="alert alert-info text-center mt-4"
        role="alert"
    >

        <i class="fa-solid fa-house"></i>

        No listings available.

    </div>

<% } %>



<!-- ================================================= -->
<!-- TAX CALCULATION SCRIPT -->
<!-- ================================================= -->

<script>

    const taxSwitch =
        document.getElementById("switchCheckDefault");

    const taxInfo =
        document.querySelectorAll(".tax-info");

    const listingPrices =
        document.querySelectorAll(".listing-price");


    taxSwitch.addEventListener("change", function () {

        listingPrices.forEach((priceElement, index) => {

            const price =
                Number(priceElement.dataset.price);

            if (this.checked) {

                // 18% GST
                const priceWithTax =
                    price + (price * 18 / 100);

                priceElement.innerHTML =
                    "&#8377;" +
                    priceWithTax.toLocaleString("en-IN");

                taxInfo[index].style.display = "inline";

            } else {

                priceElement.innerHTML =
                    "&#8377;" +
                    price.toLocaleString("en-IN");

                taxInfo[index].style.display = "none";

            }

        });

    });

</script>