</div>

<!-- =====================================================
     TAX SWITCH
===================================================== -->

<div id="tax-toggle">

```
<div class="form-check form-switch">

    <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="switchCheckDefault"
    >

    <label
        class="form-check-label"
        for="switchCheckDefault"
    >
        Display after taxes
    </label>

</div>
```

</div>

<!-- =====================================================
     SEARCH MESSAGE
===================================================== -->

<% if (
typeof searchMessage !== "undefined" &&
searchMessage
) { %>

```
<div
    class="alert alert-warning text-center mt-4 search-message"
    role="alert"
>

    <i class="fa-solid fa-location-dot"></i>

    <%= searchMessage %>

</div>
```

<% } %>

<!-- =====================================================
     CATEGORY MESSAGE
===================================================== -->

<% if (
typeof categoryMessage !== "undefined" &&
categoryMessage
) { %>

```
<div
    class="alert alert-info text-center mt-4 search-message"
    role="alert"
>

    <i class="fa-solid fa-circle-info"></i>

    <%= categoryMessage %>

</div>
```

<% } %>

<!-- =====================================================
     LISTINGS
===================================================== -->

<div class="row">

```
<% for(let listing of allListings){ %>

    <a
        href="/listings/<%= listing._id %>"
        class="listing-link col-xl-3 col-lg-4 col-md-6"
    >

        <div class="card listing-card">

            <!-- IMAGE -->

            <img
                src="<%= listing.image.url %>"
                class="card-img-top"
                alt="<%= listing.title %>"
            >


            <!-- IMAGE OVERLAY -->

            <div class="card-img-overlay">

                <h5 class="card-title"></h5>

                <p class="card-text"></p>

                <p class="card-text">
                    <small></small>
                </p>

            </div>


            <!-- CARD BODY -->

            <div class="card-body">

                <p class="card-text">

                    <!-- TITLE -->

                    <b>
                        <%= listing.title %>
                    </b>

                    <br>


                    <!-- PRICE -->

                    <span
                        class="listing-price"
                        data-price="<%= listing.price %>"
                    >
                        &#8377;<%= Number(
                            listing.price
                        ).toLocaleString("en-IN") %>
                    </span>

                    / night


                    <!-- TAX -->

                    <i class="tax-info">
                        &nbsp;+18% GST
                    </i>

                </p>

            </div>

        </div>

    </a>

<% } %>
```

</div>

<!-- =====================================================
     NO LISTINGS
===================================================== -->

<% if (
allListings.length === 0 &&
!searchMessage &&
!categoryMessage
) { %>

```
<div
    class="alert alert-info text-center empty-message"
    role="alert"
>

    <i class="fa-solid fa-house"></i>

    No listings available.

</div>

<% } %>
