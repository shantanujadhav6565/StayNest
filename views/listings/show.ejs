    <% layout('layouts/boilerplate') -%>

    <div class="row mt-4">
        <div class="col-lg-8 offset-lg-2">

            <div class="card show-card">

                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top show-img"
                    alt="Listing Image"
                >

                <div class="card-body">

                    <h3 class="card-title mb-3">
                        <%= listing.title %>
                    </h3>


                    <p class="card-text">
                        <i>
                            Owned by 
                            <strong>
                                <%= listing.owner ? listing.owner.username : "Unknown" %>
                            </strong>
                        </i>
                    </p>


                    <p class="card-text">
                        <strong>Price:</strong>
                        ₹<%= Number(listing.price).toLocaleString("en-IN") %> / night
                    </p>


                    <p class="card-text">
                        <strong>Description:</strong><br>
                        <%= listing.description %>
                    </p>


                    <p class="card-text">
                        <strong>Location:</strong><br>
                        <%= listing.location %>, <%= listing.country %>
                    </p>



                    <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)){ %>


                    <form
                        action="/listings/<%= listing._id %>/edit"
                        method="GET"
                        class="d-inline"
                    >
                        <button class="btn btn-dark">
                            Edit
                        </button>
                    </form>



                    <form
                        action="/listings/<%= listing._id %>?_method=DELETE"
                        method="POST"
                        class="d-inline"
                    >
                        <button class="btn btn-danger">
                            Delete
                        </button>
                    </form>


                    <% } %>


                </div>

            </div>

        </div>
    </div>


    <!-- map -->
    <hr>
    <h3 class="mb-3 offset-2">Location Map</h3>
    <div class="d-flex flex-wrap gap-2 mb-3 offset-2">

    <button class="btn btn-outline-dark btn-sm" onclick="changeStyle('streets')">
        🗺️ Map
    </button>

    <button class="btn btn-outline-dark btn-sm" onclick="changeStyle('satellite')">
        🛰️ Satellite
    </button>

    <button class="btn btn-outline-dark btn-sm" onclick="changeStyle('hybrid')">
        🌍 Hybrid
    </button>

    <button class="btn btn-outline-dark btn-sm" onclick="changeStyle('outdoor')">
        🏕 Outdoor
    </button>

    <button class="btn btn-outline-dark btn-sm" onclick="changeStyle('bright')">
        ☀ Bright
    </button>

    <button class="btn btn-outline-dark btn-sm" onclick="changeStyle('basic')">
        📄 Basic
    </button>

</div>

    <div id="map"></div>

    <!-- ================= Review Form ================= -->


    <div class="row mt-5">

        <div class="col-lg-8 offset-lg-2">

            <hr>


            <h3 class="mb-3">
                Leave a Review
            </h3>



            <% if(currUser){ %>


            <form
                action="/listings/<%= listing._id %>/reviews"
                method="POST"
                class="needs-validation"
                novalidate
            >


                <div class="mb-3">


                    <fieldset class="starability-slot">

                        <legend>
                            Rate this Listing
                        </legend>


                        <input
                            type="radio"
                            id="no-rate"
                            class="input-no-rate"
                            name="review[rating]"
                            value="0"
                            checked
                        />


                        <input type="radio" id="rate1" name="review[rating]" value="1">
                        <label for="rate1">1 star</label>


                        <input type="radio" id="rate2" name="review[rating]" value="2">
                        <label for="rate2">2 stars</label>


                        <input type="radio" id="rate3" name="review[rating]" value="3">
                        <label for="rate3">3 stars</label>


                        <input type="radio" id="rate4" name="review[rating]" value="4">
                        <label for="rate4">4 stars</label>


                        <input type="radio" id="rate5" name="review[rating]" value="5">
                        <label for="rate5">5 stars</label>


                    </fieldset>


                </div>




                <div class="mb-3">

                    <label class="form-label">
                        Comment
                    </label>


                    <textarea
                        name="review[comment]"
                        rows="4"
                        class="form-control"
                        required
                    ></textarea>


                    <div class="invalid-feedback">
                        Please enter a comment.
                    </div>


                </div>



                <button class="btn btn-outline-dark">
                    Submit
                </button>


            </form>


            <% } else { %>


            <p class="text-muted">
                Please login to write a review.
            </p>


            <% } %>



            <hr>



            <h3 class="mb-3">
                All Reviews
            </h3>




            <div class="row">


                <% if(listing.reviews && listing.reviews.length > 0){ %>


                    <% for(let review of listing.reviews){ %>



                    <div class="card col-md-5 me-3 mb-3">


                        <div class="card-body">


                            <h5 class="card-title">

                                @<%= review.author ? review.author.username : "Anonymous" %>

                            </h5>



                            <fieldset
                                class="starability-result"
                                data-rating="<%= review.rating %>"
                            >

                                Rated:
                                <%= review.rating %>
                                stars

                            </fieldset>




                            <p class="card-text mt-2">

                                <%= review.comment %>

                            </p>



                        </div>





                        <% if(currUser && review.author && review.author._id.equals(currUser._id)){ %>



                        <form
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                            method="POST"
                            class="ms-3 mb-3"
                        >

                            <button class="btn btn-sm btn-dark">
                                Delete
                            </button>


                        </form>



                        <% } %>



                    </div>




                    <% } %>



                <% } else { %>



                    <p class="text-muted">
                        No reviews yet.
                    </p>



                <% } %>



            </div>


        </div>

    </div>



    <script>
        const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
        const mapToken = "<%= mapToken %>";
        const listingTitle = "<%= listing.title %>";
    </script>

    <link
        rel="stylesheet"
        href="https://cdn.maptiler.com/maptiler-sdk-js/latest/maptiler-sdk.css"
    />

    <script src="https://cdn.maptiler.com/maptiler-sdk-js/latest/maptiler-sdk.umd.min.js"></script>

    <script src="/js/map.js"></script>
    <script src="/js/script.js"></script>